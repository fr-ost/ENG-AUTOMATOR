# Copy to .env for local runs:  cp .env.example .env
# NEVER commit .env. In GitHub Actions, put secrets in repository Secrets and
# the other values in repository Variables (see README).

# ---------------- X API v2 (required) ----------------
# App-only Bearer Token from your project at https://console.x.com (developer portal)
X_BEARER_TOKEN=
# Your handle without "@" (used to look up your user ID once and build URLs)
X_USERNAME=
# Optional: numeric user ID; skips the username lookup request
X_USER_ID=

# ---------------- Scanning (optional) ----------------
INCLUDE_QUOTE_POSTS=true        # replies and reposts are always excluded
X_MAX_PAGES=5                   # up to 100 posts per page
SCAN_OVERLAP_HOURS=2            # re-check this much before the last checkpoint
INITIAL_LOOKBACK_HOURS=24       # first run only
METRICS_LOOKBACK_DAYS=7         # refresh public metrics for posts this recent; 0 = off
# SCAN_SINCE=2026-10-01T00:00:00Z   # manual recovery: rescan from this UTC time
# ALLOW_STATE_REINIT=false          # recovery: quarantine corrupt state files
# DRY_RUN=false

# ---------------- Promotion planning targets ----------------
IMPRESSION_TARGET=1000
LIKE_TARGET=30
# PROMOTION_BUDGET=0
# PROMOTION_BUDGET_CURRENCY=USD

# ---------------- SMMSOC (optional, read-only, disabled by default) ----------------
# Verify the API format against https://smmsoc.com/api before enabling (see README).
SMM_ENABLED=false
# Documented base URL (per your notes; confirm on the docs page):
SMM_API_URL=https://smmsoc.com/api/v2
SMM_API_KEY=
SMM_IMPRESSION_SERVICE_ID=
SMM_LIKE_SERVICE_ID=

# ---------------- Telegram (optional) ----------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------- Cost estimation (optional) ----------------
# Fill in ONLY with prices you have confirmed for your own X API plan.
# X_COST_PER_REQUEST_USD=
# X_COST_PER_POST_READ_USD=

# LOG_LEVEL=INFO
